# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة
# (المشروع يعمل بدون أي مفاتيح API إجبارية حاليًا - كل المصادر مجانية وعامة)

# منفذ تشغيل الـ API محليًا
APP_PORT=8000

# مهلة الطلبات بالثواني عند جلب صفحات مباشر
REQUEST_TIMEOUT_SECONDS=15

# التأخير بين الطلبات المتتابعة لصفحات مباشر (احترامًا للسيرفر)
REQUEST_DELAY_SECONDS=1.0
